# Pulse 生产环境配置模板
#
# 部署前：复制本文件为 .env.prod 并填入真实强随机口令（.env.prod 已被 .gitignore 忽略，不会进仓库）。
# 生成随机口令示例（任选其一）：
#   openssl rand -base64 24
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
#
# 所有口令仅在 Docker 内部网络使用，不会暴露到公网；但请务必使用强随机值，不要用下方占位。

# MySQL 超级用户口令（API / Worker 通过 ConnectionStrings__MySql 自动引用，无需重复填写）
MYSQL_ROOT_PASSWORD=__CHANGE_ME_mysql_32_random_chars__

# 业务库名（一般保持 pulse）
MYSQL_DATABASE=pulse

# Redis 访问口令（compose 中以 --requirepass 启动，连接串带上 password=）
REDIS_PASSWORD=__CHANGE_ME_redis_32_random_chars__

# RabbitMQ 独立账号（取代默认 guest，避免 guest 仅限 loopback 的限制并收紧权限）
RABBITMQ_DEFAULT_USER=pulse
RABBITMQ_DEFAULT_PASS=__CHANGE_ME_rabbitmq_32_random_chars__
